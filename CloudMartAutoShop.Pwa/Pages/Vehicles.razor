@page "/vehicles"
@inject ApiService Api

<h1>Vehicles</h1>
<p class="subtitle">Manage customer vehicles and service mileage</p>

<div class="panel">

    <div class="toolbar">
        <div>
            <strong>Vehicle List</strong>
            <span class="list-count">@items.Count vehicle(s)</span>
        </div>

        <button type="button"
                class="btn"
                @onclick="NewVehicle">
            + New Vehicle
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert success">
            @message
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert error">
            @error
        </div>
    }

    @if (showForm)
    {
        <div class="edit-panel">

            <div class="form-header">
                <div>
                    <h3>@(edit.Id == 0 ? "New Vehicle" : "Edit Vehicle")</h3>

                    <p>
                        @(edit.Id == 0
                                            ? "Enter the customer's vehicle information."
                                            : "Update the vehicle information.")
                </p>
            </div>

                <button type="button"
                        class="icon-button"
                        title="Close"
                        @onclick="CancelEdit">
                    ×
                </button>
            </div>

            <EditForm Model="edit"
                      OnValidSubmit="Save">

                <DataAnnotationsValidator />

                <div class="form-grid">

                    <div>
                        <label>
                            Customer
                            <span class="required">*</span>
                        </label>

                        <InputSelect class="form-control"
                                     @bind-Value="edit.CustomerId">

                            <option value="0">
                                Select customer
                            </option>

                        @foreach (var customer in SelectableCustomers())
                            {
                                <option value="@customer.Id">
                                    @customer.Name
                                    @(!customer.IsActive ? " (Inactive)" : "")
                                </option>
                            }

                    </InputSelect>
                </div>

                <div>
                    <label>Status</label>

                    <InputSelect class="form-control"
                                 @bind-Value="edit.IsActive">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </InputSelect>
                </div>

                <div>
                    <label>VIN</label>

                    <InputText class="form-control"
                               maxlength="17"
                               @bind-Value="edit.Vin" />

                    <small class="field-hint">
                        Optional. Standard VINs contain 17 characters.
                    </small>
                </div>

                <div>
                    <label>Year</label>

                    <InputNumber class="form-control"
                                 @bind-Value="edit.Year" />
                </div>

                <div>
                    <label>Make</label>

                    <InputText class="form-control"
                               @bind-Value="edit.Make" />
                </div>

                <div>
                    <label>Model</label>

                    <InputText class="form-control"
                               @bind-Value="edit.Model" />
                </div>

                <div>
                    <label>Trim</label>

                    <InputText class="form-control"
                               @bind-Value="edit.Trim" />
                </div>

                <div>
                    <label>Licence Plate</label>

                    <InputText class="form-control"
                               @bind-Value="edit.LicensePlate" />
                </div>

                <div>
                    <label>Colour</label>

                    <InputText class="form-control"
                               @bind-Value="edit.Color" />
                </div>

                <div>
                    <label>Current Mileage</label>

                    <InputNumber class="form-control"
                                 @bind-Value="edit.CurrentMileage" />
                </div>

                <div class="full">
                    <label>Notes</label>

                    <InputTextArea class="form-control notes"
                                   @bind-Value="edit.Notes" />
                </div>

            </div>

            <div class="form-actions">

                <button type="submit"
                        class="btn"
                        disabled="@saving">

                    @(saving
                                        ? "Saving..."
                                        : edit.Id == 0
                                        ? "Save Vehicle"
                                        : "Save Changes")

                </button>

                    <button type="button"
                            class="btn secondary"
                            @onclick="CancelEdit">
                        Cancel
                    </button>

                </div>

            </EditForm>

        </div>
        }

    <div class="table-wrap">

        <table>

            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Vehicle</th>
                    <th>VIN</th>
                    <th>Plate</th>
                    <th>Mileage</th>
                    <th>Status</th>
                    <th class="actions-column">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (loading)
                {
                    <tr>
                        <td colspan="7"
                            class="empty-row">
                            Loading vehicles...
                        </td>
                    </tr>
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="7"
                            class="empty-row">
                            No vehicles have been created yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var vehicle in items)
                    {
                        <tr class="@(!vehicle.IsActive ? "inactive-row" : null)">

                            <td>
                                <strong>@vehicle.CustomerName</strong>
                            </td>

                            <td>
                                <div class="vehicle-description">
                                    <strong>@VehicleTitle(vehicle)</strong>

                                    @if (!string.IsNullOrWhiteSpace(vehicle.Trim))
                                    {
                                        <small>@vehicle.Trim</small>
                                    }
                            </div>
                        </td>

                        <td>@Display(vehicle.Vin)</td>

                        <td>@Display(vehicle.LicensePlate)</td>

                        <td>@Mileage(vehicle.CurrentMileage)</td>

                        <td>
                            <span class="badge @(vehicle.IsActive ? "active" : "inactive")">
                                @(vehicle.IsActive
                                                            ? "Active"
                                                            : "Inactive")
                        </span>
                    </td>

                            <td class="row-actions">

                                <button type="button"
                                        class="action-button"
                                        title="Edit vehicle"
                                        @onclick="() => EditVehicle(vehicle)">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">
                                        <path d="M12 20h9" />
                                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                                    </svg>

                                </button>

                                <button type="button"
                                        class="action-button"
                                        title="@(vehicle.IsActive ? "Deactivate vehicle" : "Activate vehicle")"
                                        @onclick="() => ToggleStatus(vehicle)">

                            @if (vehicle.IsActive)
                                    {
                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">
                                            <circle cx="12"
                                                    cy="12"
                                                    r="9" />
                                            <path d="M9 9l6 6" />
                                            <path d="M15 9l-6 6" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">
                                            <circle cx="12"
                                                    cy="12"
                                                    r="9" />
                                            <path d="m8 12 2.5 2.5L16 9" />
                                        </svg>
                                    }

                                </button>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>

@code
{
    private List<VehicleDto> items = [];

    private List<CustomerDto> customers = [];

    private VehicleDto edit = NewVehicleModel();

    private bool showForm;
    private bool loading;
    private bool saving;

    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        error = null;

        try
        {
            items =
                await Api.Get<List<VehicleDto>>(
                    "api/Vehicles")
                ?? [];

            customers =
                await Api.Get<List<CustomerDto>>(
                    "api/Customers")
                ?? [];
        }
        catch (Exception ex)
        {
            error =
                "Unable to load vehicles. " +
                ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void NewVehicle()
    {
        message = null;
        error = null;

        edit = NewVehicleModel();

        var firstCustomer =
            customers
                .Where(x => x.IsActive)
                .OrderBy(x => x.Name)
                .FirstOrDefault();

        if (firstCustomer is not null)
        {
            edit.CustomerId = firstCustomer.Id;
        }

        showForm = true;
    }

    private void EditVehicle(
        VehicleDto vehicle)
    {
        message = null;
        error = null;

        edit = new VehicleDto
        {
            Id = vehicle.Id,
            CustomerId = vehicle.CustomerId,
            CustomerName = vehicle.CustomerName,
            Vin = vehicle.Vin,
            Year = vehicle.Year,
            Make = vehicle.Make,
            Model = vehicle.Model,
            Trim = vehicle.Trim,
            LicensePlate = vehicle.LicensePlate,
            Color = vehicle.Color,
            CurrentMileage = vehicle.CurrentMileage,
            Notes = vehicle.Notes,
            IsActive = vehicle.IsActive,
            CreatedAt = vehicle.CreatedAt
        };

        showForm = true;
    }

    private void CancelEdit()
    {
        edit = NewVehicleModel();
        showForm = false;
        error = null;
    }

    private IEnumerable<CustomerDto>
        SelectableCustomers()
    {
        return customers
            .Where(x =>
                x.IsActive ||
                (edit.Id != 0 &&
                 x.Id == edit.CustomerId))
            .OrderBy(x => x.Name);
    }

    private async Task Save()
    {
        message = null;
        error = null;

        if (edit.CustomerId <= 0)
        {
            error = "Please select a customer.";
            return;
        }

        if (edit.Year.HasValue)
        {
            var maximumYear =
                DateTime.Now.Year + 1;

            if (edit.Year.Value < 1886 ||
                edit.Year.Value > maximumYear)
            {
                error =
                    $"Vehicle year must be between 1886 and {maximumYear}.";
                return;
            }
        }

        if (edit.CurrentMileage.HasValue &&
            edit.CurrentMileage.Value < 0)
        {
            error =
                "Mileage cannot be negative.";
            return;
        }

        var vin =
            Clean(edit.Vin)?.ToUpperInvariant();

        if (!string.IsNullOrWhiteSpace(vin))
        {
            if (vin.Length != 17)
            {
                error =
                    "VIN must contain exactly 17 characters.";
                return;
            }

            if (vin.Contains('I') ||
                vin.Contains('O') ||
                vin.Contains('Q'))
            {
                error =
                    "VIN cannot contain the letters I, O or Q.";
                return;
            }
        }

        saving = true;

        try
        {
            var request = new
            {
                edit.CustomerId,
                Vin = vin,
                edit.Year,
                Make = Clean(edit.Make),
                Model = Clean(edit.Model),
                Trim = Clean(edit.Trim),
                LicensePlate =
                    Clean(edit.LicensePlate),
                Color = Clean(edit.Color),
                edit.CurrentMileage,
                Notes = Clean(edit.Notes),
                edit.IsActive
            };

            bool success;

            if (edit.Id == 0)
            {
                success =
                    await Api.Post(
                        "api/Vehicles",
                        request);
            }
            else
            {
                success =
                    await Api.Put(
                        $"api/Vehicles/{edit.Id}",
                        request);
            }

            if (!success)
            {
                error =
                    "The vehicle could not be saved. " +
                    "Please verify the vehicle information.";
                return;
            }

            message =
                edit.Id == 0
                    ? "Vehicle created successfully."
                    : "Vehicle updated successfully.";

            showForm = false;
            edit = NewVehicleModel();

            await Load();
        }
        catch (Exception ex)
        {
            error =
                "The vehicle could not be saved. " +
                ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleStatus(
        VehicleDto vehicle)
    {
        message = null;
        error = null;

        try
        {
            var newStatus =
                !vehicle.IsActive;

            var success =
                await Api.Patch(
                    $"api/Vehicles/{vehicle.Id}/status",
                    new
                    {
                        IsActive = newStatus
                    });

            if (!success)
            {
                error =
                    "The vehicle status could not be changed.";
                return;
            }

            message =
                newStatus
                    ? $"{VehicleTitle(vehicle)} has been activated."
                    : $"{VehicleTitle(vehicle)} has been deactivated.";

            await Load();
        }
        catch (Exception ex)
        {
            error =
                "The vehicle status could not be changed. " +
                ex.Message;
        }
    }

    private static VehicleDto NewVehicleModel()
    {
        return new VehicleDto
        {
            IsActive = true
        };
    }

    private static string VehicleTitle(
        VehicleDto vehicle)
    {
        var parts =
            new[]
            {
                vehicle.Year?.ToString(),
                vehicle.Make,
                vehicle.Model
            }
            .Where(x =>
                !string.IsNullOrWhiteSpace(x));

        var result =
            string.Join(" ", parts);

        return string.IsNullOrWhiteSpace(result)
            ? "Vehicle"
            : result;
    }

    private static string Mileage(
        int? value)
    {
        return value.HasValue
            ? value.Value.ToString("N0")
            : "—";
    }

    private static string Display(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "—"
            : value;
    }

    private static string? Clean(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();
    }
}