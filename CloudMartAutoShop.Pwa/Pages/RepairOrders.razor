                                    @repairOrder.RepairOrderNumber
                                </button>

                                @if (!string.IsNullOrWhiteSpace(repairOrder.InvoiceNumber))
                                {
                                    <small class="table-secondary">
                                        Invoice @repairOrder.InvoiceNumber
                                    </small>
                                }
                            </div>

                            <span class="badge">
                                @repairOrder.Status
                            </span>
                        </div>

                        <div class="mobile-ro-details">
                            <div>
                                <span class="mobile-ro-label">Date</span>
                                <span>@repairOrder.OpenedDate.ToString("yyyy-MM-dd")</span>
                            </div>

                            <div>
                                <span class="mobile-ro-label">Customer</span>
                                <span>@repairOrder.CustomerName</span>
                            </div>

                            <div>
                                <span class="mobile-ro-label">Vehicle</span>
                                <span>@repairOrder.Vehicle</span>
