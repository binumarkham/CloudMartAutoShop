            NewRepairOrderModel();

        detail = null;

        labor =
            NewLaborModel();
        part = NewPartModel();
        payment = NewPaymentModel();

        showForm = false;

        error = null;
        laborError = null;
        laborMessage = null;
        partError = null;
        partMessage = null;
        paymentError = null;
        paymentMessage = null;
