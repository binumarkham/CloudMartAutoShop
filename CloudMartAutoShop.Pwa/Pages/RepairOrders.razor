    private async Task SaveQuickPart()
    {
        quickPartError = null;
        if (string.IsNullOrWhiteSpace(quickPart.Description)) { quickPartError = "Part description is required."; return; }
        if (quickPart.DefaultUnitCost < 0 || quickPart.DefaultUnitPrice < 0)
        {
            quickPartError = "Part cost and price cannot be negative.";
            return;
        }

        savingQuickPart = true;
        try
        {
            var request = new PartCatalogSaveRequest
            {
                PartNumber = Clean(quickPart.PartNumber),
                Description = quickPart.Description.Trim(),
                PreferredSupplierId = quickPart.PreferredSupplierId,
                DefaultUnitCost = quickPart.DefaultUnitCost,
                DefaultUnitPrice = quickPart.DefaultUnitPrice,
                IsActive = true
            };

            var created = await Api.Post<PartCatalogSaveRequest, PartCreateResponse>("api/Parts", request);
            if (created is null || created.Id <= 0) { quickPartError = "The part could not be created."; return; }

            partCatalog = await Api.Get<List<PartCatalogDto>>("api/RepairOrders/parts/catalog") ?? [];
            var saved = partCatalog.FirstOrDefault(x => x.Id == created.Id);
            if (saved is null)
            {
                quickPartError = "The part was created, but it could not be loaded into the repair order.";
                return;
            }

            selectedCatalogId = saved.Id;
            part.PartId = saved.Id;
            part.SupplierId = saved.SupplierId;
            part.PartNumber = saved.PartNumber;
            part.Description = saved.Description;
            part.UnitCost = saved.UnitCost;
            part.UnitPrice = saved.UnitPrice;
            if (part.Quantity <= 0) part.Quantity = 1m;

            quickPart = NewQuickPartModel();
            showQuickPart = false;
            partMessage = "Catalog part created and selected.";
        }
        catch (Exception ex) { quickPartError = "The part could not be created. " + ex.Message; }
        finally { savingQuickPart = false; }
    }

    private async Task RefreshRepairOrderList()
    {
        await LoadRepairOrderPage();
        var current = items.FirstOrDefault(x => x.Id == edit.Id);
        if (current is not null) ApplyTotals(current);
    }

    private async Task LoadRepairOrderPage()
    {
        var encodedSearch = Uri.EscapeDataString(searchText.Trim());
        var result = await Api.Get<RepairOrderPageResponse>(
            $"api/RepairOrders/paged?search={encodedSearch}&page={currentPage}&pageSize={pageSize}");

        if (result is null)
        {
            items = [];
            totalCount = 0;
            totalPages = 1;
            currentPage = 1;
            return;
        }

        items = result.Items ?? [];
        totalCount = result.TotalCount;
        currentPage = result.Page;
        pageSize = result.PageSize;
        totalPages = Math.Max(result.TotalPages, 1);
    }

    private async Task SearchInputChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        searchDebounce?.Cancel();
        searchDebounce?.Dispose();
        searchDebounce = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, searchDebounce.Token);
            loading = true;
            await LoadRepairOrderPage();
        }
        catch (OperationCanceledException) { return; }
        finally { loading = false; }
    }

    private async Task ClearSearch()
    {
        searchDebounce?.Cancel();
        searchText = string.Empty;
        currentPage = 1;
        loading = true;
        try { await LoadRepairOrderPage(); }
        finally { loading = false; }
    }

    private async Task PreviousPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
        loading = true;
        try { await LoadRepairOrderPage(); }
        finally { loading = false; }
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
        loading = true;
        try { await LoadRepairOrderPage(); }
        finally { loading = false; }
    }

    private async Task CancelEdit()
    {
        if (HasUnsavedChanges)
        {
            var leave = await JS.InvokeAsync<bool>(
                "confirm",
                "You have unsaved changes to this repair order. Are you sure you want to leave without saving?");

            if (!leave)
            {
                return;
            }
        }

        CloseRepairOrderForm();
    }

    private void CloseRepairOrderForm()
    {
        edit = NewRepairOrderModel();
        detail = null;
        labor = NewLaborModel();
        part = NewPartModel();
        payment = NewPaymentModel();
        showForm = false;
        repairOrderSnapshot = string.Empty;

        error = null;
        laborError = null;
        laborMessage = null;
        partError = null;
        partMessage = null;
        paymentError = null;
        paymentMessage = null;
