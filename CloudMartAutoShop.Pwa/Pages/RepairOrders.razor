    private void CustomerChanged(
        int customerId)
    {
        edit.CustomerId = customerId;
        edit.VehicleId = 0;
        edit.MileageIn = null;
        showQuickVehicle = false;
        quickVehicleError = null;

        var firstVehicle =
            vehicles
                .Where(x =>
                    x.CustomerId == customerId &&
                    x.IsActive)
                .OrderByDescending(x => x.Year)
                .ThenBy(x => x.Make)
                .ThenBy(x => x.Model)
                .FirstOrDefault();

        if (firstVehicle is not null)
        {
            edit.VehicleId =
                firstVehicle.Id;

            edit.MileageIn =
                firstVehicle.CurrentMileage;
        }
    }

    private IEnumerable<CustomerDto>
        SelectableCustomers()
    {
        return customers
            .Where(x =>
                x.IsActive ||
                (edit.Id != 0 &&
                 x.Id == edit.CustomerId))
            .OrderBy(x => x.Name);
    }

    private IEnumerable<VehicleDto>
        SelectableVehicles()
    {
        return vehicles
            .Where(x =>
                x.CustomerId ==
                    edit.CustomerId &&
                (x.IsActive ||
                 (edit.Id != 0 &&
                  x.Id == edit.VehicleId)))
            .OrderByDescending(x => x.Year)
            .ThenBy(x => x.Make)
            .ThenBy(x => x.Model);
    }

    private async Task Save()
    {
        message = null;
        error = null;

        if (edit.CustomerId <= 0)
        {
            error =
                "Please select a customer.";
            return;
        }

        if (edit.VehicleId <= 0)
        {
            error =
                "Please select a vehicle.";
            return;
        }

        if (string.IsNullOrWhiteSpace(
            edit.RepairOrderNumber))
        {
            error =
                "Repair order number is required.";
            return;
        }

        if (edit.MileageIn.HasValue &&
            edit.MileageIn.Value < 0)
        {
            error =
                "Mileage In cannot be negative.";
            return;
        }

        if (edit.MileageOut.HasValue &&
            edit.MileageOut.Value < 0)
        {
            error =
                "Mileage Out cannot be negative.";
            return;
        }

        saving = true;

        try
        {
            var openedDateUtc =
                ToUtc(
                    edit.OpenedDate);

            DateTime? completedDateUtc =
                edit.CompletedDate.HasValue
                    ? ToUtc(
                        edit.CompletedDate.Value)
                    : null;

            var request = new
            {
                edit.CustomerId,
                edit.VehicleId,

                RepairOrderNumber =
                    edit.RepairOrderNumber.Trim(),

                InvoiceNumber =
                    Clean(
                        edit.InvoiceNumber),

                OpenedDate =
                    openedDateUtc,

                CompletedDate =
                    completedDateUtc,

                edit.Status,
                edit.MileageIn,
                edit.MileageOut,

                CustomerConcern =
                    Clean(
                        edit.CustomerConcern),

                Diagnosis =
                    Clean(
                        edit.Diagnosis),

                WorkPerformed =
                    Clean(
                        edit.WorkPerformed),

                TechnicianName =
                    Clean(
                        edit.TechnicianName),

                AssignedTechnicianUserId =
                    edit.AssignedTechnicianUserId,

                Notes =
                    Clean(
                        edit.Notes),

                edit.TaxAmount
            };

            bool success;
            int? createdRepairOrderId = null;

            if (edit.Id == 0)
            {
                var result =
                    await Api.Post<object, CreateRepairOrderResponse>(
                        "api/RepairOrders",
                        request);
                success = result is not null && result.Id > 0;

                if (success)
                {
                    createdRepairOrderId = result!.Id;
                }
            }
            else
            {
                success =
                    await Api.Put(
                        $"api/RepairOrders/{edit.Id}",
                        request);
            }

            if (!success)
            {
                error =
                    "The repair order could not be saved. " +
                    "Please verify the information.";
                return;
            }

            if (createdRepairOrderId.HasValue)
            {
                await Load();

                var createdRepairOrder =
                    items.FirstOrDefault(
                        x => x.Id == createdRepairOrderId.Value);

                if (createdRepairOrder is not null)
                {
                    await EditRepairOrder(createdRepairOrder);

                    message =
                        "Repair order created successfully. " +
                        "You can now add labor and parts.";
                }
                else
                {
                    message = "Repair order created successfully.";
                    showForm = false;
                    edit = NewRepairOrderModel();
                    detail = null;
                    labor = NewLaborModel();
                    part = NewPartModel();
                }
            }
            else
            {
                message = "Repair order updated successfully.";
                showForm = false;
                edit = NewRepairOrderModel();
                detail = null;
                labor = NewLaborModel();
                part = NewPartModel();

                await Load();
            }
        }
        catch (Exception ex)
        {
            error =
                "The repair order could not be saved. " +
                ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

