@page "/repair-orders"
@inject ApiService Api

<h1>Repair Orders</h1>
<p class="subtitle">Track work from intake through payment</p>

<div class="panel">

    <div class="toolbar">
        <div>
            <strong>Repair Order List</strong>
            <span class="list-count">@items.Count repair order(s)</span>
        </div>

        <button type="button"
                class="btn"
                @onclick="NewRepairOrder">
            + New Repair Order
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert success">
            @message
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert error">
            @error
        </div>
    }

    @if (showForm)
    {
        <div class="edit-panel">

            <div class="form-header">
                <div>
                    <h3>
                        @(edit.Id == 0
                                            ? "New Repair Order"
                                            : $"Edit Repair Order {edit.RepairOrderNumber}")
                                                                                        </h3>

                    <p>
                        @(edit.Id == 0
                                            ? "Create a repair order for an active customer and vehicle."
                                            : "Update repair order information and job status.")
                </p>
            </div>

                <button type="button"
                        class="icon-button"
                        title="Close"
                        @onclick="CancelEdit">
                    Ã—
                </button>
            </div>

            <EditForm Model="edit"
                      OnSubmit="Save">

                <div class="form-grid">

                    <div>
                        <div style="display:flex; justify-content:space-between; align-items:center; gap:10px;">
                            <label>Customer <span class="required">*</span></label>
                            <button type="button" class="btn small secondary" @onclick="OpenQuickCustomer">+ Add Customer</button>
                        </div>
                        <InputSelect TValue="int" class="form-control" Value="@edit.CustomerId"
                                     ValueChanged="@((int value) => CustomerChanged(value))"
                                     ValueExpression="@(() => edit.CustomerId)">
                            <option value="0">Select customer</option>
                        @foreach (var customer in SelectableCustomers())
                            {
                                <option value="@customer.Id">@customer.Name @(!customer.IsActive ? " (Inactive)" : "")</option>
                            }
                        </InputSelect>
                    </div>

                    <div>
                        <div style="display:flex; justify-content:space-between; align-items:center; gap:10px;">
                            <label>Vehicle <span class="required">*</span></label>
                            <button type="button" class="btn small secondary" disabled="@(edit.CustomerId <= 0)" @onclick="OpenQuickVehicle">+ Add Vehicle</button>
                        </div>
                        <InputSelect class="form-control" @bind-Value="edit.VehicleId">
                            <option value="0">Select vehicle</option>
                            @foreach (var vehicle in SelectableVehicles())
                            {
                                <option value="@vehicle.Id">@VehicleOption(vehicle) @(!vehicle.IsActive ? " (Inactive)" : "")</option>
                            }
                        </InputSelect>
                    </div>

                    @if (showQuickCustomer)
                    {
                        <div class="full">
                            <div class="edit-panel quick-create-panel" style="margin-top:0;">
                                <div class="form-header">
                                    <div><h3>Add Customer</h3><p>Creating a new customer for this Repair Order.</p></div>
                                    <button type="button" class="icon-button" title="Close" @onclick="CancelQuickCustomer">×</button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(quickCustomerError))
                                {
                                    <div class="alert error">@quickCustomerError</div>
                                }
                                <div class="form-grid">
                                    <div><label>Name <span class="required">*</span></label><InputText class="form-control" @bind-Value="quickCustomer.Name" /></div>
                                    <div><label>Phone</label><InputText class="form-control" @bind-Value="quickCustomer.Phone" /></div>
                                    <div><label>Email</label><InputText class="form-control" @bind-Value="quickCustomer.Email" /></div>
                                    <div class="full"><label>Address</label><InputText class="form-control" @bind-Value="quickCustomer.Address" /></div>
                                    <div><label>City</label><InputText class="form-control" @bind-Value="quickCustomer.City" /></div>
                                    <div><label>Province / State</label><InputText class="form-control" @bind-Value="quickCustomer.ProvinceState" /></div>
                                    <div><label>Postal / ZIP Code</label><InputText class="form-control" @bind-Value="quickCustomer.PostalCode" /></div>
                                    <div class="full"><label>Notes</label><InputTextArea class="form-control notes" @bind-Value="quickCustomer.Notes" /></div>
                                </div>
                                <div class="form-actions">
                                    <button type="button" class="btn" disabled="@savingQuickCustomer" @onclick="SaveQuickCustomer">@(savingQuickCustomer ? "Saving..." : "Save Customer")</button>
                                    <button type="button" class="btn secondary" disabled="@savingQuickCustomer" @onclick="CancelQuickCustomer">Cancel</button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (showQuickVehicle)
                    {
                        <div class="full">
                            <div class="edit-panel quick-create-panel" style="margin-top:0;">
                                <div class="form-header">
                                    <div><h3>Add Vehicle</h3><p>Creating a new vehicle for this Repair Order.</p></div>
                                    <button type="button" class="icon-button" title="Close" @onclick="CancelQuickVehicle">×</button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(quickVehicleError))
                                {
                                    <div class="alert error">@quickVehicleError</div>
                                }
                                <div class="form-grid">
                                    <div><label>Customer</label><div class="calculated-value">@SelectedCustomerName</div></div>
                                    <div><label>VIN</label><InputText class="form-control" maxlength="17" @bind-Value="quickVehicle.Vin" /></div>
                                    <div><label>Year</label><InputNumber class="form-control" @bind-Value="quickVehicle.Year" /></div>
                                    <div><label>Make</label><InputText class="form-control" @bind-Value="quickVehicle.Make" /></div>
                                    <div><label>Model</label><InputText class="form-control" @bind-Value="quickVehicle.Model" /></div>
                                    <div><label>Trim</label><InputText class="form-control" @bind-Value="quickVehicle.Trim" /></div>
                                    <div><label>Licence Plate</label><InputText class="form-control" @bind-Value="quickVehicle.LicensePlate" /></div>
                                    <div><label>Colour</label><InputText class="form-control" @bind-Value="quickVehicle.Color" /></div>
                                    <div><label>Current Mileage</label><InputNumber class="form-control" @bind-Value="quickVehicle.CurrentMileage" /></div>
                                    <div class="full"><label>Notes</label><InputTextArea class="form-control notes" @bind-Value="quickVehicle.Notes" /></div>
                                </div>
                                <div class="form-actions">
                                    <button type="button" class="btn" disabled="@savingQuickVehicle" @onclick="SaveQuickVehicle">@(savingQuickVehicle ? "Saving..." : "Save Vehicle")</button>
                                    <button type="button" class="btn secondary" disabled="@savingQuickVehicle" @onclick="CancelQuickVehicle">Cancel</button>
                                </div>
                            </div>
                        </div>
                    }

                    <div>
                        <label>
                            Repair Order Number
                            <span class="required">*</span>
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="edit.RepairOrderNumber" />
                    </div>

                    <div>
                        <label>Invoice Number</label>

                        <InputText class="form-control"
                                   @bind-Value="edit.InvoiceNumber" />
                    </div>

                    <div>
                        <label>Opened Date</label>

                        <InputDate class="form-control"
                                   @bind-Value="edit.OpenedDate" />
                    </div>

                    <div>
                        <label>Status</label>

                        <InputSelect class="form-control"
                                     @bind-Value="edit.Status">

                            @foreach (var status in statuses)
                            {
                                <option value="@status">
                                    @status
                                </option>
                            }

                        </InputSelect>
                    </div>

                    <div>
                        <label>Mileage In</label>

                        <InputNumber class="form-control"
                                     @bind-Value="edit.MileageIn" />
                    </div>

                    <div>
                        <label>Mileage Out</label>

                        <InputNumber class="form-control"
                                     @bind-Value="edit.MileageOut" />
                    </div>

                    <div>
                        <label>Assigned Technician</label>

                        <InputSelect TValue="int?" class="form-control" @bind-Value="edit.AssignedTechnicianUserId">
                            <option value="">Unassigned</option>
                            @foreach (var technician in technicians)
                            {
                                <option value="@technician.Id">@technician.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <div>
                        <label>Completed Date</label>

                        <InputDate class="form-control"
                                   @bind-Value="edit.CompletedDate" />
                    </div>

                    <div class="full">
                        <label>Customer Concern</label>

                        <InputTextArea class="form-control notes"
                                       @bind-Value="edit.CustomerConcern" />
                    </div>

                    <div class="full">
                        <label>Diagnosis</label>

                        <InputTextArea class="form-control notes"
                                       @bind-Value="edit.Diagnosis" />
                    </div>

                    <div class="full">
                        <label>Work Performed</label>

                        <InputTextArea class="form-control notes"
                                       @bind-Value="edit.WorkPerformed" />
                    </div>

                    <div class="full">
                        <label>Notes</label>

                        <InputTextArea class="form-control notes"
                                       @bind-Value="edit.Notes" />
                    </div>

                </div>

                @if (edit.Id != 0)
                {
                    <div class="ro-summary">

                        <div class="summary-item">
                            <span>Labor</span>
                            <strong>
                                @edit.LaborSubtotal.ToString("C")
                            </strong>
                        </div>

                        <div class="summary-item">
                            <span>Parts</span>
                            <strong>
                                @edit.PartsSubtotal.ToString("C")
                            </strong>
                        </div>

                        <div class="summary-item">
                            <span>Subtotal</span>
                            <strong>
                                @edit.Subtotal.ToString("C")
                            </strong>
                        </div>

                        <div class="summary-item">
                            <span>Tax</span>
                            <strong>
                                @edit.TaxAmount.ToString("C")
                            </strong>
                        </div>

                        <div class="summary-item">
                            <span>Total</span>
                            <strong>
                                @edit.TotalAmount.ToString("C")
                            </strong>
                        </div>

                        <div class="summary-item">
                            <span>Paid</span>
                            <strong>
                                @edit.AmountPaid.ToString("C")
                            </strong>
                        </div>

                        <div class="summary-item">
                            <span>Balance</span>
                            <strong>
                                @edit.Balance.ToString("C")
                            </strong>
                        </div>

                    </div>
                }

            <div class="form-actions">

                <button type="submit"
                        class="btn"
                        disabled="@saving">

                    @(saving
                                        ? "Saving..."
                                        : edit.Id == 0
                                        ? "Create Repair Order"
                                        : "Save Changes")

                </button>

                    <button type="button"
                            class="btn secondary"
                            @onclick="CancelEdit">
                        Cancel
                    </button>

                </div>

            </EditForm>

        @if (edit.Id != 0)
            {
                <div class="labor-section">

                    <div class="section-heading">
                        <div>
                            <h3>Labor</h3>
                            <p>
                                Add labor performed for this repair order.
                            </p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(laborMessage))
                    {
                        <div class="alert success">
                            @laborMessage
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(laborError))
                    {
                        <div class="alert error">
                            @laborError
                        </div>
                    }

            <div class="labor-entry-grid">

                <div class="labor-description">
                    <label>
                        Description
                        <span class="required">*</span>
                    </label>

                    <InputText class="form-control"
                               @bind-Value="labor.Description" />
                </div>

                <div>
                    <label>Technician</label>

                    <input class="form-control"
                           value="@LaborTechnicianDisplayName"
                           readonly />
                </div>

                <div>
                    <label>
                        Hours
                        <span class="required">*</span>
                    </label>

                    <InputNumber class="form-control"
                                 @bind-Value="labor.Hours" />
                </div>

                <div>
                    <label>Hourly Rate</label>

                    <InputNumber class="form-control"
                                 @bind-Value="labor.HourlyRate" />
                </div>

                <div>
                    <label>Line Total</label>

                    <div class="calculated-value">
                        @LaborPreviewTotal.ToString("C")
                    </div>
                </div>

            </div>

            <div class="labor-notes-entry">
                <label>Technician Notes</label>
                <InputTextArea class="form-control notes" @bind-Value="labor.TechnicianNotes" />
            </div>

            <div class="labor-actions">
                <button type="button"
                        class="btn"
                        disabled="@savingLabor"
                        @onclick="AddLabor">

                    @(savingLabor
                                        ? "Saving..."
                                        : editingLaborId.HasValue
                                        ? "Save Labor Changes"
                                        : "+ Add Labor")

                </button>
                @if (editingLaborId.HasValue)
                        {
                            <button type="button"
                                    class="btn secondary"
                                    disabled="@savingLabor"
                                    @onclick="CancelLaborEdit">
                                Cancel Edit
                            </button>
                        }
                    </div>

                    <div class="table-wrap labor-table">

                        <table>
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th>Technician</th>
                                    <th>Technician Notes</th>
                                    <th>Hours</th>
                                    <th>Hourly Rate</th>
                                    <th>Line Total</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (loadingDetail)
                                {
                                    <tr>
                                        <td colspan="7"
                                            class="empty-row">
                                            Loading labor...
                                        </td>
                                    </tr>
                                }
                                else if (detail is null ||
                                detail.LaborLines.Count == 0)
                                {
                                    <tr>
                                        <td colspan="7"
                                            class="empty-row">
                                            No labor has been added yet.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var line in detail.LaborLines)
                                    {
                                        <tr>
                                            <td>
                                                @line.Description
                                            </td>

                                            <td>
                                                @(string.IsNullOrWhiteSpace(
                                                                                line.TechnicianName)
                                                                                ? "â€”"
                                                                                : line.TechnicianName)
                            </td>

                                            <td>
                                                @(string.IsNullOrWhiteSpace(line.TechnicianNotes) ? "â€”" : line.TechnicianNotes)
                                            </td>

                                            <td>
                                                @line.Hours.ToString("0.##")
                                            </td>

                                            <td>
                                                @line.HourlyRate.ToString("C")
                                            </td>

                                            <td>
                                                <strong>
                                                    @line.LineTotal.ToString("C")
                                                </strong>
                                            </td>
                                            <td>
                                                <div class="row-actions">

                                                    <button type="button"
                                                            class="btn small secondary"
                                                            @onclick="() => EditLabor(line)">
                                                        Edit
                                                    </button>

                                                    <button type="button"
                                                            class="btn small secondary"
                                                            disabled="@savingLabor"
                                                            @onclick="() => DeleteLabor(line)">
                                                        Delete
                                                    </button>

                                                </div>
                                            </td>
                                        </tr>
                                                }
                                }

                            </tbody>
                        </table>

                    </div>

                </div>

                <div class="labor-section">
                    <div class="section-heading"><div><h3>Parts</h3><p>Add parts and materials used on this repair order.</p></div></div>
                    @if (!string.IsNullOrWhiteSpace(partMessage))
                    {
                        <div class="alert success">@partMessage</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(partError))
                    {
                        <div class="alert error">@partError</div>
                    }
                    <div class="part-catalog-picker">
                        <div style="display:flex; justify-content:space-between; align-items:center; gap:10px;">
                            <label>Use Previous Part</label>
                            <button type="button" class="btn small secondary" @onclick="OpenQuickPart">+ Add Catalog Part</button>
                        </div>
                        <select class="form-control" value="@selectedCatalogId" @onchange="SelectCatalogPart">
                            <option value="0">Enter a new part manually</option>
                            @foreach (var saved in partCatalog)
                            {
                                <option value="@saved.Id">@(string.IsNullOrWhiteSpace(saved.PartNumber) ? saved.Description : $"{saved.PartNumber} — {saved.Description}")</option>
                            }
                        </select>
                        <small>Selecting a previous part fills supplier, description, cost and selling price. You can still change any value before saving.</small>
                    </div>

                    @if (showQuickPart)
                    {
                        <div class="edit-panel quick-create-panel" style="margin-top:12px;">
                            <div class="form-header">
                                <div><h3>Add Catalog Part</h3><p>Creating a new reusable catalog part for this Repair Order.</p></div>
                                <button type="button" class="icon-button" title="Close" @onclick="CancelQuickPart">×</button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(quickPartError))
                            {
                                <div class="alert error">@quickPartError</div>
                            }
                            <div class="form-grid">
                                <div><label>Part Number</label><InputText class="form-control" @bind-Value="quickPart.PartNumber" /></div>
                                <div class="full"><label>Description <span class="required">*</span></label><InputText class="form-control" @bind-Value="quickPart.Description" /></div>
                                <div>
                                    <label>Preferred Supplier</label>
                                    <InputSelect TValue="int?" class="form-control" @bind-Value="quickPart.PreferredSupplierId">
                                        <option value="">No preferred supplier</option>
                                        @foreach (var supplier in suppliers.Where(x => x.IsActive).OrderBy(x => x.Name))
                                        {
                                            <option value="@supplier.Id">@supplier.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div><label>Default Unit Cost</label><InputNumber class="form-control" @bind-Value="quickPart.DefaultUnitCost" /></div>
                                <div><label>Default Unit Price</label><InputNumber class="form-control" @bind-Value="quickPart.DefaultUnitPrice" /></div>
                            </div>
                            <div class="form-actions">
                                <button type="button" class="btn" disabled="@savingQuickPart" @onclick="SaveQuickPart">@(savingQuickPart ? "Saving..." : "Create Part")</button>
                                <button type="button" class="btn secondary" disabled="@savingQuickPart" @onclick="CancelQuickPart">Cancel</button>
                            </div>
                        </div>
                    }
                    <div class="part-entry-grid">
                        <div>
                            <label>Supplier</label><InputSelect class="form-control" @bind-Value="part.SupplierId">
                                <option value="">No supplier / Other</option>@foreach (var supplier in suppliers.Where(x => x.IsActive).OrderBy(x => x.Name)) {
                                <option value="@supplier.Id">@supplier.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div><label>Part Number</label><InputText class="form-control" @bind-Value="part.PartNumber" /></div>
                    <div class="part-description"><label>Description <span class="required">*</span></label><InputText class="form-control" @bind-Value="part.Description" /></div>
                    <div><label>Quantity <span class="required">*</span></label><InputNumber class="form-control" @bind-Value="part.Quantity" /></div>
                    <div><label>Unit Cost</label><InputNumber class="form-control" @bind-Value="part.UnitCost" /></div>
                    <div><label>Unit Price</label><InputNumber class="form-control" @bind-Value="part.UnitPrice" /></div>
                    <div><label>Line Total</label><div class="calculated-value">@PartPreviewTotal.ToString("C")</div></div>
                </div>
                <div class="labor-actions">
                    <button type="button" class="btn" disabled="@savingPart" @onclick="SavePart">@(savingPart ? "Saving..." : editingPartId.HasValue ? "Save Part Changes" : "+ Add Part")</button>
                    @if (editingPartId.HasValue)
                    {
                        <button type="button" class="btn secondary" disabled="@savingPart" @onclick="CancelPartEdit">Cancel Edit</button>
                    }
                </div>
                <div class="table-wrap labor-table">
                    <table>
                        <thead><tr><th>Supplier</th><th>Part Number</th><th>Description</th><th>Qty</th><th>Unit Cost</th><th>Unit Price</th><th>Line Total</th><th>Actions</th></tr></thead>
                        <tbody>
                            @if (loadingDetail)
                            {
                                <tr><td colspan="8" class="empty-row">Loading parts...</td></tr>
                            }
                            else if (detail is null || detail.PartLines.Count == 0)
                            {
                                <tr><td colspan="8" class="empty-row">No parts have been added yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var line in detail.PartLines)
                                {
                                    <tr><td>@DisplayValue(line.SupplierName)</td><td>@DisplayValue(line.PartNumber)</td><td>@line.Description</td><td>@line.Quantity.ToString("0.###")</td><td>@line.UnitCost.ToString("C")</td><td>@line.UnitPrice.ToString("C")</td><td><strong>@line.LineTotal.ToString("C")</strong></td><td><button type="button" class="btn small secondary" @onclick="() => EditPart(line)">Edit</button></td></tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="labor-section">
                <div class="section-heading">
                    <div>
                        <h3>Payments</h3>
                        <p>Record customer payments for this repair order.</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(paymentMessage))
                {
                    <div class="alert success">@paymentMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(paymentError))
                {
                    <div class="alert error">@paymentError</div>
                }

                @if (edit.Balance > 0)
                {
                    <div class="part-entry-grid">
                        <div>
                            <label>Amount <span class="required">*</span></label>
                            <InputNumber @bind-Value="payment.Amount"
                                         class="form-control"
                                         step="0.01"
                                         format="0.00" />
                            <small>Remaining balance: @edit.Balance.ToString("C")</small>
                        </div>

                        <div>
                            <label>Payment Date <span class="required">*</span></label>
                            <InputDate class="form-control" @bind-Value="payment.PaymentDate" />
                        </div>

                        <div>
                            <label>Payment Method <span class="required">*</span></label>
                            <InputSelect class="form-control" @bind-Value="payment.PaymentMethod">
                                <option value="Cash">Cash</option>
                                <option value="Debit">Debit</option>
                                <option value="Credit Card">Credit Card</option>
                                <option value="E-Transfer">E-Transfer</option>
                                <option value="Cheque">Cheque</option>
                                <option value="Other">Other</option>
                            </InputSelect>
                        </div>

                        <div>
                            <label>Reference Number</label>
                            <InputText class="form-control" @bind-Value="payment.ReferenceNumber" />
                        </div>

                        <div class="part-description">
                            <label>Notes</label>
                            <InputText class="form-control" @bind-Value="payment.Notes" />
                        </div>
                    </div>

                    <div class="labor-actions">
                        <button type="button"
                                class="btn"
                                disabled="@savingPayment"
                                @onclick="RecordPayment">
                            @(savingPayment ? "Recording..." : "Record Payment")
                        </button>
                    </div>
                }
                else
                {
                    <div class="alert success">
                        This repair order is fully paid.
                    </div>
                }

                <div class="table-wrap labor-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Reference</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (loadingDetail)
                            {
                                <tr>
                                    <td colspan="5" class="empty-row">Loading payments...</td>
                                </tr>
                            }
                            else if (detail is null || detail.Payments.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="empty-row">No payments have been recorded yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var paymentLine in detail.Payments)
                                {
                                    <tr>
                                        <td>@ToLocalDate(paymentLine.PaymentDate).ToString("MMM d, yyyy")</td>
                                        <td><strong>@paymentLine.Amount.ToString("C")</strong></td>
                                        <td>@paymentLine.PaymentMethod</td>
                                        <td>@DisplayValue(paymentLine.ReferenceNumber)</td>
                                        <td>@DisplayValue(paymentLine.Notes)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </div>
        }

    <div class="table-wrap repair-orders-table">

        <table>

            <thead>
                <tr>
                    <th>RO Number</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Vehicle</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Paid</th>
                    <th>Balance</th>
                </tr>
            </thead>

            <tbody>

                @if (loading)
                {
                    <tr>
                        <td colspan="8"
                            class="empty-row">
                            Loading repair orders...
                        </td>
                    </tr>
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="8"
                            class="empty-row">
                            No repair orders have been created yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var repairOrder in items)
                    {
                        <tr>

                            <td>
                                <button type="button"
                                        class="repair-order-link"
                                        title="Open repair order"
                                        @onclick="() => EditRepairOrder(repairOrder)">
                                    @repairOrder.RepairOrderNumber
                                </button>

                                @if (!string.IsNullOrWhiteSpace(repairOrder.InvoiceNumber))
                                {
                                    <small class="table-secondary">
                                        Invoice @repairOrder.InvoiceNumber
                                    </small>
                                }
                            </td>

                            <td>
                                @repairOrder.OpenedDate.ToString("yyyy-MM-dd")
                            </td>

                            <td>
                                @repairOrder.CustomerName
                            </td>

                            <td>
                                @repairOrder.Vehicle
                            </td>

                            <td>
                                <span class="badge">
                                    @repairOrder.Status
                                </span>
                            </td>

                            <td>
                                @repairOrder.TotalAmount.ToString("C")
                            </td>

                            <td>
                                @repairOrder.AmountPaid.ToString("C")
                            </td>

                            <td>
                                <strong>
                                    @repairOrder.Balance.ToString("C")
                                </strong>
                            </td>



                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

    <div class="repair-orders-mobile">

        @if (loading)
        {
            <div class="mobile-ro-empty">
                Loading repair orders...
            </div>
        }
        else if (items.Count == 0)
        {
            <div class="mobile-ro-empty">
                No repair orders have been created yet.
            </div>
        }
        else
        {
            @foreach (var repairOrder in items)
            {
                <div class="mobile-ro-card">

                    <div class="mobile-ro-header">
                        <div>
                            <button type="button"
                                    class="repair-order-link"
                                    title="Open repair order"
                                    @onclick="() => EditRepairOrder(repairOrder)">
                                @repairOrder.RepairOrderNumber
                            </button>

                            @if (!string.IsNullOrWhiteSpace(repairOrder.InvoiceNumber))
                            {
                                <small class="table-secondary">
                                    Invoice @repairOrder.InvoiceNumber
                                </small>
                            }
                        </div>

                        <span class="badge">
                            @repairOrder.Status
                        </span>
                    </div>

                    <div class="mobile-ro-details">
                        <div>
                            <span class="mobile-ro-label">Date</span>
                            <span>@repairOrder.OpenedDate.ToString("yyyy-MM-dd")</span>
                        </div>

                        <div>
                            <span class="mobile-ro-label">Customer</span>
                            <span>@repairOrder.CustomerName</span>
                        </div>

                        <div>
                            <span class="mobile-ro-label">Vehicle</span>
                            <span>@repairOrder.Vehicle</span>
                        </div>
                    </div>

                    <div class="mobile-ro-totals">
                        <div>
                            <span>Total</span>
                            <strong>@repairOrder.TotalAmount.ToString("C")</strong>
                        </div>

                        <div>
                            <span>Paid</span>
                            <strong>@repairOrder.AmountPaid.ToString("C")</strong>
                        </div>

                        <div>
                            <span>Balance</span>
                            <strong>@repairOrder.Balance.ToString("C")</strong>
                        </div>
                    </div>

                </div>
            }
        }

    </div>
</div>


<style>
