        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    }

        .quick-create-panel .form-header {
            padding-bottom: 12px;
            margin-bottom: 16px;
            border-bottom: 1px solid #cfe3e0;
        }

            .quick-create-panel .form-header h3 {
                margin-bottom: 4px;
            }

            .quick-create-panel .form-header p {
                margin-bottom: 0;
            }

    @@media (max-width: 700px) {
        .quick-create-panel {
            padding: 14px;
        }
    }
</style>

@code
{
    private readonly string[] statuses =
    [
        "Open",
        "In Progress",
        "Waiting for Parts",
        "Completed",
        "Invoiced",
        "Cancelled"
    ];

    private List<RepairOrderDto> items = [];

    private List<CustomerDto> customers = [];

    private List<VehicleDto> vehicles = [];

    private List<TechnicianDto> technicians = [];

    private List<SupplierDto> suppliers = [];

    private List<PartCatalogDto> partCatalog = [];
    private int selectedCatalogId;
    private int? editingPartId;
    private int? editingLaborId;

    private RepairOrderDto edit =
        NewRepairOrderModel();

    private RepairOrderDetailDto? detail;

    private LaborSaveRequest labor =
        NewLaborModel();

    private PartSaveRequest part =
        NewPartModel();

    private CustomerDto quickCustomer = NewQuickCustomerModel();
    private VehicleDto quickVehicle = NewQuickVehicleModel();
    private PartDto quickPart = NewQuickPartModel();

    private PaymentSaveRequest payment =
        NewPaymentModel();

    private bool showForm;
    private bool loading;
    private bool saving;

    private bool loadingDetail;
    private bool savingLabor;
    private bool savingPart;
    private bool savingPayment;

    private bool showQuickCustomer;
    private bool savingQuickCustomer;
    private bool showQuickVehicle;
    private bool savingQuickVehicle;
    private bool showQuickPart;
    private bool savingQuickPart;

    private string? message;
    private string? error;

    private string? laborMessage;
    private string? laborError;
    private string? partMessage;
    private string? partError;
    private string? paymentMessage;
    private string? paymentError;
    private string? quickCustomerError;
    private string? quickVehicleError;
    private string? quickPartError;

    private string SelectedCustomerName =>
        customers.FirstOrDefault(x => x.Id == edit.CustomerId)?.Name ?? "Selected customer";

    private string AssignedTechnicianName =>
        edit.AssignedTechnicianUserId.HasValue
            ? technicians.FirstOrDefault(x => x.Id == edit.AssignedTechnicianUserId.Value)?.Name
                ?? edit.AssignedTechnicianName
                ?? ""
            : "";

    private string LaborTechnicianDisplayName =>
        editingLaborId.HasValue
            ? (labor.TechnicianName ?? "")
            : AssignedTechnicianName;

    private decimal LaborPreviewTotal => labor.Hours * labor.HourlyRate;
    private decimal PartPreviewTotal => part.Quantity * part.UnitPrice;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        error = null;

        try
        {
            items =
                await Api.Get<List<RepairOrderDto>>(
                    "api/RepairOrders")
                ?? [];

            customers =
                await Api.Get<List<CustomerDto>>(
                    "api/Customers")
                ?? [];

            vehicles =
                await Api.Get<List<VehicleDto>>(
                    "api/Vehicles")
                ?? [];

            technicians =
                await Api.Get<List<TechnicianDto>>(
                    "api/Technicians")
                ?? [];

            suppliers =
                await Api.Get<List<SupplierDto>>(
                    "api/Suppliers")
                ?? [];

            partCatalog =
                await Api.Get<List<PartCatalogDto>>(
                    "api/RepairOrders/parts/catalog")
                ?? [];
        }
        catch (Exception ex)
        {
            error =
                "Unable to load repair orders. " +
                ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void NewRepairOrder()
    {
        message = null;
        error = null;

        laborMessage = null;
        laborError = null;
        partMessage = null;
        partError = null;

        detail = null;
        labor = NewLaborModel();
        part = NewPartModel();
        payment = NewPaymentModel();
        paymentMessage = null;
        paymentError = null;

        edit = NewRepairOrderModel();

        var firstCustomer =
            customers
                .Where(x => x.IsActive)
                .OrderBy(x => x.Name)
                .FirstOrDefault();

        if (firstCustomer is not null)
        {
            edit.CustomerId =
                firstCustomer.Id;

            var firstVehicle =
                vehicles
                    .Where(x =>
                        x.CustomerId == firstCustomer.Id &&
                        x.IsActive)
                    .OrderByDescending(x => x.Year)
                    .ThenBy(x => x.Make)
                    .ThenBy(x => x.Model)
                    .FirstOrDefault();

            if (firstVehicle is not null)
            {
                edit.VehicleId =
                    firstVehicle.Id;

                edit.MileageIn =
                    firstVehicle.CurrentMileage;
            }
        }

        showForm = true;
    }

    private async Task EditRepairOrder(
        RepairOrderDto repairOrder)
    {
        message = null;
        error = null;

        laborMessage = null;
        laborError = null;
        partMessage = null;
        partError = null;

        detail = null;
        labor = NewLaborModel();
        part = NewPartModel();
        payment = NewPaymentModel();
        paymentMessage = null;
        paymentError = null;

        edit = new RepairOrderDto
        {
            Id = repairOrder.Id,

            CustomerId =
                repairOrder.CustomerId,

            VehicleId =
                repairOrder.VehicleId,

            RepairOrderNumber =
                repairOrder.RepairOrderNumber,

            InvoiceNumber =
                repairOrder.InvoiceNumber,

            OpenedDate =
                ToLocalDate(
                    repairOrder.OpenedDate),

            CompletedDate =
                repairOrder.CompletedDate.HasValue
                    ? ToLocalDate(
                        repairOrder.CompletedDate.Value)
                    : null,

            MileageIn =
                repairOrder.MileageIn,

            MileageOut =
                repairOrder.MileageOut,

            Status =
                repairOrder.Status,

            CustomerName =
                repairOrder.CustomerName,

            Vehicle =
                repairOrder.Vehicle,

            CustomerConcern =
                repairOrder.CustomerConcern,

            Diagnosis =
                repairOrder.Diagnosis,

            WorkPerformed =
                repairOrder.WorkPerformed,

            TechnicianName =
                repairOrder.TechnicianName,

            AssignedTechnicianUserId =
                repairOrder.AssignedTechnicianUserId,

            AssignedTechnicianName =
                repairOrder.AssignedTechnicianName,

            LaborSubtotal =
                repairOrder.LaborSubtotal,

            PartsSubtotal =
                repairOrder.PartsSubtotal,

            Subtotal =
                repairOrder.Subtotal,

            TaxAmount =
                repairOrder.TaxAmount,

            TotalAmount =
                repairOrder.TotalAmount,

            AmountPaid =
                repairOrder.AmountPaid,

            Balance =
                repairOrder.Balance,

            Notes =
                repairOrder.Notes,

            CreatedByUserId =
                repairOrder.CreatedByUserId,

            CreatedByName =
                repairOrder.CreatedByName,

            CreatedAt =
                repairOrder.CreatedAt,

            UpdatedAt =
                repairOrder.UpdatedAt
        };

        showForm = true;

        await LoadRepairOrderDetail(
            repairOrder.Id);
    }

    private async Task LoadRepairOrderDetail(
        int repairOrderId)
    {
        loadingDetail = true;
        laborError = null;

        try
        {
            detail =
                await Api.Get<RepairOrderDetailDto>(
                    $"api/RepairOrders/{repairOrderId}");

            if (detail is null)
            {
                laborError =
                    "Unable to load repair order details.";
                return;
            }

            ApplyTotals(detail);

        }
        catch (Exception ex)
        {
            laborError =
                "Unable to load repair order details. " +
                ex.Message;
        }
        finally
        {
            loadingDetail = false;
        }
    }

    private void ApplyTotals(
        RepairOrderDto source)
    {
        edit.LaborSubtotal =
            source.LaborSubtotal;

        edit.PartsSubtotal =
            source.PartsSubtotal;

        edit.Subtotal =
            source.Subtotal;

        edit.TaxAmount =
            source.TaxAmount;

        edit.TotalAmount =
            source.TotalAmount;

        edit.AmountPaid =
            source.AmountPaid;

        edit.Balance =
            source.Balance;
    }

    private async Task AddLabor()
    {
        laborMessage = null;
        laborError = null;

        if (edit.Id <= 0)
        {
            laborError =
                "Save the repair order before adding labor.";
            return;
        }

        if (string.IsNullOrWhiteSpace(
            labor.Description))
        {
            laborError =
                "Labor description is required.";
            return;
        }

        if (labor.Hours <= 0)
        {
            laborError =
                "Labor hours must be greater than zero.";
            return;
        }

        if (labor.HourlyRate < 0)
        {
            laborError =
                "Hourly rate cannot be negative.";
            return;
        }

        savingLabor = true;

        try
        {
            var request =
                new LaborSaveRequest
                {
                    Description =
                        labor.Description.Trim(),

                    TechnicianName =
                        Clean(
                            editingLaborId.HasValue
                                ? labor.TechnicianName
                                : AssignedTechnicianName),

                    TechnicianNotes =
                        Clean(
                            labor.TechnicianNotes),

                    Hours =
                        labor.Hours,

                    HourlyRate =
                        labor.HourlyRate
                };

            var success =
    editingLaborId.HasValue
        ? await Api.Put(
            $"api/RepairOrders/{edit.Id}/labor/{editingLaborId.Value}",
            request)
        : await Api.Post(
            $"api/RepairOrders/{edit.Id}/labor",
            request);

            if (!success)
            {
                laborError =
                    editingLaborId.HasValue
                        ? "The labor line could not be updated."
                        : "The labor line could not be added.";

                return;
            }

            laborMessage =
                editingLaborId.HasValue
                    ? "Labor updated successfully."
                    : "Labor added successfully.";

            labor =
                NewLaborModel();

            editingLaborId = null;

            await LoadRepairOrderDetail(
                edit.Id);

            await RefreshRepairOrderList();
        }
        catch (Exception ex)
        {
            laborError =
                "The labor line could not be added. " +
                ex.Message;
        }
        finally
        {
            savingLabor = false;
        }
    }
    private void EditLabor(
    RepairOrderLaborDto line)
    {
        editingLaborId = line.Id;

        laborMessage = null;
        laborError = null;

        labor = new LaborSaveRequest
        {
            Description = line.Description,
            TechnicianName = line.TechnicianName,
            TechnicianNotes = line.TechnicianNotes,
            Hours = line.Hours,
            HourlyRate = line.HourlyRate
        };
    }

    private async Task DeleteLabor(
        RepairOrderLaborDto line)
    {
        laborMessage = null;
        laborError = null;

        savingLabor = true;

        try
        {
            var success =
                await Api.Delete(
                    $"api/RepairOrders/{edit.Id}/labor/{line.Id}");

            if (!success)
            {
                laborError =
                    "The labor line could not be deleted.";
                return;
            }

            if (editingLaborId == line.Id)
            {
                editingLaborId = null;
                labor = NewLaborModel();
            }

            laborMessage =
                "Labor deleted successfully.";

            await LoadRepairOrderDetail(
                edit.Id);

            await RefreshRepairOrderList();
        }
        catch (Exception ex)
        {
            laborError =
                "The labor line could not be deleted. " +
                ex.Message;
        }
        finally
        {
            savingLabor = false;
        }
    }
    private void CancelLaborEdit()
    {
        editingLaborId = null;
        labor = NewLaborModel();
        laborMessage = null;
        laborError = null;
    }
    private async Task SavePart()
    {
        partMessage = null; partError = null;
        if (edit.Id <= 0) { partError = "Save the repair order before adding parts."; return; }
        if (string.IsNullOrWhiteSpace(part.Description)) { partError = "Part description is required."; return; }
        if (part.Quantity <= 0) { partError = "Part quantity must be greater than zero."; return; }
        if (part.UnitCost < 0 || part.UnitPrice < 0) { partError = "Part cost and price cannot be negative."; return; }
        savingPart = true;
        try
        {
            var request = new PartSaveRequest
            {
                PartId = part.PartId,
                SupplierId = part.SupplierId,
                PartNumber = Clean(part.PartNumber),
                Description = part.Description.Trim(),
                Quantity = part.Quantity,
                UnitCost = part.UnitCost,
                UnitPrice = part.UnitPrice
            };
            var success = editingPartId.HasValue
                ? await Api.Put($"api/RepairOrders/{edit.Id}/parts/{editingPartId.Value}", request)
                : await Api.Post($"api/RepairOrders/{edit.Id}/parts", request);
            if (!success) { partError = editingPartId.HasValue ? "The part line could not be updated." : "The part line could not be added."; return; }
            partMessage = editingPartId.HasValue ? "Part updated successfully." : "Part added successfully.";
            part = NewPartModel(); editingPartId = null; selectedCatalogId = 0;
            await LoadRepairOrderDetail(edit.Id); await RefreshRepairOrderList();
            partCatalog = await Api.Get<List<PartCatalogDto>>("api/RepairOrders/parts/catalog") ?? [];
        }
        catch (Exception ex) { partError = "The part line could not be added. " + ex.Message; }
        finally { savingPart = false; }
    }
    private async Task RecordPayment()
    {
        paymentMessage = null;
        paymentError = null;

        if (edit.Id <= 0)
        {
            paymentError =
                "Save the repair order before recording a payment.";
            return;
        }

        if (!payment.Amount.HasValue || payment.Amount.Value <= 0)
        {
            paymentError =
                "Payment amount must be greater than zero.";
            return;
        }

        if (edit.Balance <= 0)
        {
            paymentError =
                "This repair order has no outstanding balance.";
            return;
        }

        if (payment.Amount.Value > edit.Balance)
        {
            paymentError =
                $"Payment cannot exceed the remaining balance of " +
                $"{edit.Balance:C}.";
            return;
        }

        if (string.IsNullOrWhiteSpace(payment.PaymentMethod))
        {
            paymentError =
                "Please select a payment method.";
            return;
        }

        savingPayment = true;

        try
        {
            var request = new PaymentSaveRequest
            {
                Amount = payment.Amount.Value,

                PaymentDate =
                    ToUtc(payment.PaymentDate),

                PaymentMethod =
                    payment.PaymentMethod,

                ReferenceNumber =
                    Clean(payment.ReferenceNumber),

                Notes =
                    Clean(payment.Notes)
            };

            var success =
                await Api.Post(
                    $"api/RepairOrders/{edit.Id}/payments",
                    request);

            if (!success)
            {
                paymentError =
                    "The payment could not be recorded.";
                return;
            }

            paymentMessage =
                $"Payment of {payment.Amount.Value:C} recorded successfully.";

            payment =
                NewPaymentModel();

            await LoadRepairOrderDetail(
                edit.Id);

            await RefreshRepairOrderList();
        }
        catch (Exception ex)
        {
            paymentError =
                "The payment could not be recorded. " +
                ex.Message;
        }
        finally
        {
            savingPayment = false;
        }
    }
    private void EditPart(RepairOrderPartDto line)
    {
        editingPartId = line.Id;
        selectedCatalogId = 0;

        partMessage = null;
        partError = null;

        part = new PartSaveRequest
        {
            PartId = line.PartId,
            SupplierId = line.SupplierId,
            PartNumber = line.PartNumber,
            Description = line.Description,
            Quantity = line.Quantity,
            UnitCost = line.UnitCost,
            UnitPrice = line.UnitPrice
        };
    }

    private void CancelPartEdit()
    {
        editingPartId = null;
        selectedCatalogId = 0;
        part = NewPartModel();
        partMessage = null;
        partError = null;
    }

    private void SelectCatalogPart(ChangeEventArgs e)
    {
        if (!int.TryParse(
                e.Value?.ToString(),
                out selectedCatalogId) ||
            selectedCatalogId <= 0)
        {
            selectedCatalogId = 0;

            // Returning to manual entry means this line is
            // no longer linked to a master catalog Part.
            part.PartId = null;

            return;
        }

        var saved =
            partCatalog.FirstOrDefault(
                x => x.Id == selectedCatalogId);

        if (saved is null)
        {
            part.PartId = null;
            return;
        }

        part.PartId = saved.Id;
        part.SupplierId = saved.SupplierId;
        part.PartNumber = saved.PartNumber;
        part.Description = saved.Description;
        part.UnitCost = saved.UnitCost;
        part.UnitPrice = saved.UnitPrice;

        if (part.Quantity <= 0)
        {
            part.Quantity = 1m;
        }
    }


    private void OpenQuickCustomer()
    {
        quickCustomer = NewQuickCustomerModel();
        quickCustomerError = null;
        showQuickCustomer = true;
        showQuickVehicle = false;
    }

    private void CancelQuickCustomer()
    {
        quickCustomer = NewQuickCustomerModel();
        quickCustomerError = null;
        showQuickCustomer = false;
    }

    private async Task SaveQuickCustomer()
    {
        quickCustomerError = null;
        if (string.IsNullOrWhiteSpace(quickCustomer.Name))
        {
            quickCustomerError = "Customer name is required.";
            return;
        }

        savingQuickCustomer = true;
        try
        {
            var request = new
            {
                Name = quickCustomer.Name.Trim(),
                Phone = Clean(quickCustomer.Phone),
                Email = Clean(quickCustomer.Email),
                Address = Clean(quickCustomer.Address),
                City = Clean(quickCustomer.City),
                ProvinceState = Clean(quickCustomer.ProvinceState),
                PostalCode = Clean(quickCustomer.PostalCode),
                Notes = Clean(quickCustomer.Notes),
                IsActive = true
            };

            var created = await Api.Post<object, CustomerDto>("api/Customers", request);
            if (created is null || created.Id <= 0) { quickCustomerError = "The customer could not be created."; return; }

            customers = await Api.Get<List<CustomerDto>>("api/Customers") ?? [];
            edit.CustomerId = created.Id;
            edit.VehicleId = 0;
            edit.MileageIn = null;
            quickCustomer = NewQuickCustomerModel();
            showQuickCustomer = false;
            message = $"{created.Name} was created and selected.";
        }
        catch (Exception ex) { quickCustomerError = "The customer could not be created. " + ex.Message; }
        finally { savingQuickCustomer = false; }
    }

    private void OpenQuickVehicle()
    {
        quickVehicleError = null;
        if (edit.CustomerId <= 0) { quickVehicleError = "Please select a customer first."; return; }
        quickVehicle = NewQuickVehicleModel();
        quickVehicle.CustomerId = edit.CustomerId;
        showQuickVehicle = true;
        showQuickCustomer = false;
    }

    private void CancelQuickVehicle()
    {
        quickVehicle = NewQuickVehicleModel();
        quickVehicleError = null;
        showQuickVehicle = false;
    }

    private async Task SaveQuickVehicle()
    {
        quickVehicleError = null;
        if (edit.CustomerId <= 0) { quickVehicleError = "Please select a customer first."; return; }
        quickVehicle.CustomerId = edit.CustomerId;

        if (quickVehicle.Year.HasValue)
        {
            var maximumYear = DateTime.Now.Year + 1;
            if (quickVehicle.Year.Value < 1886 || quickVehicle.Year.Value > maximumYear)
            {
                quickVehicleError = $"Vehicle year must be between 1886 and {maximumYear}.";
                return;
            }
        }
        if (quickVehicle.CurrentMileage.HasValue && quickVehicle.CurrentMileage.Value < 0)
        {
            quickVehicleError = "Mileage cannot be negative.";
            return;
        }

        var vin = Clean(quickVehicle.Vin)?.ToUpperInvariant();
        if (!string.IsNullOrWhiteSpace(vin))
        {
            if (vin.Length != 17) { quickVehicleError = "VIN must contain exactly 17 characters."; return; }
            if (vin.Contains('I') || vin.Contains('O') || vin.Contains('Q'))
            {
                quickVehicleError = "VIN cannot contain the letters I, O or Q.";
                return;
            }
        }

        savingQuickVehicle = true;
        try
        {
            var request = new
            {
                CustomerId = edit.CustomerId,
                Vin = vin,
                quickVehicle.Year,
                Make = Clean(quickVehicle.Make),
                Model = Clean(quickVehicle.Model),
                Trim = Clean(quickVehicle.Trim),
                LicensePlate = Clean(quickVehicle.LicensePlate),
                Color = Clean(quickVehicle.Color),
                quickVehicle.CurrentMileage,
                Notes = Clean(quickVehicle.Notes),
                IsActive = true
            };

            var created = await Api.Post<object, VehicleDto>("api/Vehicles", request);
            if (created is null || created.Id <= 0) { quickVehicleError = "The vehicle could not be created."; return; }

            vehicles = await Api.Get<List<VehicleDto>>("api/Vehicles") ?? [];
            edit.VehicleId = created.Id;
            edit.MileageIn = created.CurrentMileage;
            quickVehicle = NewQuickVehicleModel();
            showQuickVehicle = false;
            message = "Vehicle created and selected.";
        }
        catch (Exception ex) { quickVehicleError = "The vehicle could not be created. " + ex.Message; }
        finally { savingQuickVehicle = false; }
    }

    private void OpenQuickPart()
    {
        quickPart = NewQuickPartModel();
        quickPartError = null;
        showQuickPart = true;
    }

    private void CancelQuickPart()
    {
        quickPart = NewQuickPartModel();
        quickPartError = null;
        showQuickPart = false;
    }

    private async Task SaveQuickPart()
    {
        quickPartError = null;
        if (string.IsNullOrWhiteSpace(quickPart.Description)) { quickPartError = "Part description is required."; return; }
        if (quickPart.DefaultUnitCost < 0 || quickPart.DefaultUnitPrice < 0)
        {
            quickPartError = "Part cost and price cannot be negative.";
            return;
        }

        savingQuickPart = true;
        try
        {
            var request = new PartCatalogSaveRequest
            {
                PartNumber = Clean(quickPart.PartNumber),
                Description = quickPart.Description.Trim(),
                PreferredSupplierId = quickPart.PreferredSupplierId,
                DefaultUnitCost = quickPart.DefaultUnitCost,
                DefaultUnitPrice = quickPart.DefaultUnitPrice,
                IsActive = true
            };

            var created = await Api.Post<PartCatalogSaveRequest, PartCreateResponse>("api/Parts", request);
            if (created is null || created.Id <= 0) { quickPartError = "The part could not be created."; return; }

            partCatalog = await Api.Get<List<PartCatalogDto>>("api/RepairOrders/parts/catalog") ?? [];
            var saved = partCatalog.FirstOrDefault(x => x.Id == created.Id);
            if (saved is null)
            {
                quickPartError = "The part was created, but it could not be loaded into the repair order.";
                return;
            }

            selectedCatalogId = saved.Id;
            part.PartId = saved.Id;
            part.SupplierId = saved.SupplierId;
            part.PartNumber = saved.PartNumber;
            part.Description = saved.Description;
            part.UnitCost = saved.UnitCost;
            part.UnitPrice = saved.UnitPrice;
            if (part.Quantity <= 0) part.Quantity = 1m;

            quickPart = NewQuickPartModel();
            showQuickPart = false;
            partMessage = "Catalog part created and selected.";
        }
        catch (Exception ex) { quickPartError = "The part could not be created. " + ex.Message; }
        finally { savingQuickPart = false; }
    }

    private async Task RefreshRepairOrderList()
    {
        var refreshed =
            await Api.Get<List<RepairOrderDto>>(
                "api/RepairOrders");

        if (refreshed is not null)
        {
            items = refreshed;

            var current =
                items.FirstOrDefault(
                    x => x.Id == edit.Id);

            if (current is not null)
            {
                ApplyTotals(current);
            }
        }
    }

