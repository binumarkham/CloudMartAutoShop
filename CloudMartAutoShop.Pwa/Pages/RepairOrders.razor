    private bool HasUnsavedChanges =>
        showForm &&
        !string.Equals(
            repairOrderSnapshot,
            CurrentRepairOrderFingerprint(),
            StringComparison.Ordinal);

    private void CaptureRepairOrderSnapshot()
    {
        repairOrderSnapshot = CurrentRepairOrderFingerprint();
    }

    private string CurrentRepairOrderFingerprint()
    {
        return string.Join("|",
            edit.CustomerId,
            edit.VehicleId,
            edit.InvoiceNumber ?? string.Empty,
            edit.OpenedDate.ToString("O"),
            edit.CompletedDate?.ToString("O") ?? string.Empty,
            edit.Status ?? string.Empty,
            edit.MileageIn?.ToString() ?? string.Empty,
            edit.MileageOut?.ToString() ?? string.Empty,
            edit.CustomerConcern ?? string.Empty,
            edit.Diagnosis ?? string.Empty,
            edit.WorkPerformed ?? string.Empty,
            edit.AssignedTechnicianUserId?.ToString() ?? string.Empty,
            edit.Notes ?? string.Empty,
            edit.TaxAmount.ToString());
    }

    private async Task ConfirmInternalNavigation(
        Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (!HasUnsavedChanges)
        {
            return;
        }

        var leave = await JS.InvokeAsync<bool>(
            "confirm",
            "You have unsaved changes to this repair order. Are you sure you want to leave without saving?");

        if (!leave)
        {
            context.PreventNavigation();
        }
    }

    private void CustomerChanged(
        int customerId)
    {
        edit.CustomerId = customerId;
        edit.VehicleId = 0;
        edit.MileageIn = null;
        showQuickVehicle = false;
        quickVehicleError = null;

        var firstVehicle =
            vehicles
                .Where(x =>
                    x.CustomerId == customerId &&
                    x.IsActive)
                .OrderByDescending(x => x.Year)
                .ThenBy(x => x.Make)
                .ThenBy(x => x.Model)
                .FirstOrDefault();

        if (firstVehicle is not null)
        {
            edit.VehicleId =
                firstVehicle.Id;

            edit.MileageIn =
                firstVehicle.CurrentMileage;
        }
    }

    private IEnumerable<CustomerDto>
        SelectableCustomers()
    {
        return customers
            .Where(x =>
                x.IsActive ||
                (edit.Id != 0 &&
                 x.Id == edit.CustomerId))
            .OrderBy(x => x.Name);
    }

    private IEnumerable<VehicleDto>
        SelectableVehicles()
    {
        return vehicles
            .Where(x =>
                x.CustomerId ==
                    edit.CustomerId &&
                (x.IsActive ||
                 (edit.Id != 0 &&
                  x.Id == edit.VehicleId)))
            .OrderByDescending(x => x.Year)
            .ThenBy(x => x.Make)
            .ThenBy(x => x.Model);
    }

    private async Task Save()
    {
        message = null;
        error = null;

        if (edit.CustomerId <= 0)
        {
            error =
                "Please select a customer.";
            return;
        }

        if (edit.VehicleId <= 0)
        {
            error =
                "Please select a vehicle.";
            return;
        }

        if (edit.MileageIn.HasValue &&
            edit.MileageIn.Value < 0)
        {
            error =
                "Mileage In cannot be negative.";
            return;
        }

        if (edit.MileageOut.HasValue &&
            edit.MileageOut.Value < 0)
        {
            error =
                "Mileage Out cannot be negative.";
            return;
        }

        saving = true;

        try
        {
            var openedDateUtc =
                ToUtc(
                    edit.OpenedDate);

            DateTime? completedDateUtc =
                edit.CompletedDate.HasValue
                    ? ToUtc(
                        edit.CompletedDate.Value)
                    : null;

            var request = new
            {
                edit.CustomerId,
                edit.VehicleId,

                RepairOrderNumber =
                    string.IsNullOrWhiteSpace(edit.RepairOrderNumber)
                        ? null
                        : edit.RepairOrderNumber.Trim(),

                InvoiceNumber =
                    Clean(
                        edit.InvoiceNumber),

                OpenedDate =
                    openedDateUtc,

                CompletedDate =
                    completedDateUtc,

                edit.Status,
                edit.MileageIn,
                edit.MileageOut,

                CustomerConcern =
                    Clean(
                        edit.CustomerConcern),

                Diagnosis =
                    Clean(
                        edit.Diagnosis),

                WorkPerformed =
                    Clean(
                        edit.WorkPerformed),

                TechnicianName =
                    Clean(
                        edit.TechnicianName),

                AssignedTechnicianUserId =
                    edit.AssignedTechnicianUserId,

                Notes =
                    Clean(
                        edit.Notes),

                edit.TaxAmount
            };

            bool success;
            int? createdRepairOrderId = null;

            if (edit.Id == 0)
            {
                var result =
                    await Api.Post<object, CreateRepairOrderResponse>(
                        "api/RepairOrders",
                        request);
                success = result is not null && result.Id > 0;

                if (success)
                {
                    createdRepairOrderId = result!.Id;
                }
            }
            else
            {
                success =
                    await Api.Put(
                        $"api/RepairOrders/{edit.Id}",
                        request);
            }

            if (!success)
            {
                error =
                    "The repair order could not be saved. " +
                    "Please verify the information.";
                return;
            }

            if (createdRepairOrderId.HasValue)
            {
                searchText = string.Empty;
                currentPage = 1;
                await Load();

                var createdRepairOrder =
                    items.FirstOrDefault(
                        x => x.Id == createdRepairOrderId.Value);

                if (createdRepairOrder is not null)
                {
                    await EditRepairOrder(createdRepairOrder);

                    message =
                        "Repair order created successfully. " +
                        "You can now add labor and parts.";
                }
                else
                {
                    message = "Repair order created successfully.";
                    showForm = false;
                    edit = NewRepairOrderModel();
                    detail = null;
                    labor = NewLaborModel();
                    part = NewPartModel();
                }
            }
            else
            {
                message = "Repair order updated successfully.";
                showForm = false;
                edit = NewRepairOrderModel();
                detail = null;
                labor = NewLaborModel();
                part = NewPartModel();

                await Load();
            }
        }
        catch (Exception ex)
        {
            error =
                "The repair order could not be saved. " +
                ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

