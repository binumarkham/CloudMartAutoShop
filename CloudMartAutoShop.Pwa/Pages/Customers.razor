@page "/customers"
@inject ApiService Api

<h1>Customers</h1>
<p class="subtitle">Manage customer contact information and account status</p>

<div class="panel">

    <div class="toolbar">
        <div>
            <strong>Customer List</strong>
            <span class="list-count">@items.Count customer(s)</span>
        </div>

        <button type="button"
                class="btn"
                @onclick="NewCustomer">
            + New Customer
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert success">
            @message
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert error">
            @error
        </div>
    }

    @if (showForm)
    {
        <div class="edit-panel">

            <div class="form-header">
                <div>
                    <h3>@(edit.Id == 0 ? "New Customer" : "Edit Customer")</h3>
                    <p>
                        @(edit.Id == 0
                                            ? "Enter the customer's contact information."
                                            : "Update the customer's information.")
                                                                               </p>
                                                                           </div>

                <button type="button"
                        class="icon-button"
                        title="Close"
                        @onclick="CancelEdit">
                    ×
                </button>
            </div>

            <EditForm Model="edit" OnValidSubmit="Save">
                <DataAnnotationsValidator />

                <div class="form-grid">

                    <div>
                        <label>
                            Name <span class="required">*</span>
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="edit.Name" />

                        <ValidationMessage For="@(() => edit.Name)" />
                    </div>

                    <div>
                        <label>Phone</label>

                        <InputText class="form-control"
                                   @bind-Value="edit.Phone" />
                    </div>

                    <div>
                        <label>Email</label>

                        <InputText class="form-control"
                                   @bind-Value="edit.Email" />
                    </div>

                    <div>
                        <label>Status</label>

                        <InputSelect class="form-control"
                                     @bind-Value="edit.IsActive">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </InputSelect>
                    </div>

                    <div class="full">
                        <label>Address</label>

                        <InputText class="form-control"
                                   @bind-Value="edit.Address" />
                    </div>

                    <div>
                        <label>City</label>

                        <InputText class="form-control"
                                   @bind-Value="edit.City" />
                    </div>

                    <div>
                        <label>Province / State</label>

                        <InputText class="form-control"
                                   @bind-Value="edit.ProvinceState" />
                    </div>

                    <div>
                        <label>Postal / ZIP Code</label>

                        <InputText class="form-control"
                                   @bind-Value="edit.PostalCode" />
                    </div>

                    <div class="full">
                        <label>Notes</label>

                        <InputTextArea class="form-control notes"
                                       @bind-Value="edit.Notes" />
                    </div>

                </div>

                <div class="form-actions">

                    <button type="submit"
                            class="btn"
                            disabled="@saving">
                        @(saving
                                            ? "Saving..."
                                            : edit.Id == 0
                                            ? "Save Customer"
                                            : "Save Changes")
                </button>

                    <button type="button"
                            class="btn secondary"
                            @onclick="CancelEdit">
                        Cancel
                    </button>

                </div>

            </EditForm>

        </div>
        }

    <div class="table-wrap">

        <table>

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>City</th>
                    <th>Province</th>
                    <th>Status</th>
                    <th class="actions-column">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (loading)
                {
                    <tr>
                        <td colspan="7"
                            class="empty-row">
                            Loading customers...
                        </td>
                    </tr>
                }
                else if (items.Count == 0)
                {
                    <tr>
                        <td colspan="7"
                            class="empty-row">
                            No customers have been created yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var customer in items)
                    {
                        <tr class="@(!customer.IsActive ? "inactive-row" : null)">

                            <td>
                                <strong>@customer.Name</strong>
                            </td>

                            <td>@Display(customer.Phone)</td>

                            <td>@Display(customer.Email)</td>

                            <td>@Display(customer.City)</td>

                            <td>@Display(customer.ProvinceState)</td>

                            <td>
                                <span class="badge @(customer.IsActive ? "active" : "inactive")">
                                    @(customer.IsActive
                                                                ? "Active"
                                                                : "Inactive")
                        </span>
                    </td>

                            <td class="row-actions">

                                <button type="button"
                                        class="action-button"
                                        title="Edit customer"
                                        @onclick="() => EditCustomer(customer)">
                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">
                                        <path d="M12 20h9" />
                                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                                    </svg>
                                </button>

                                <button type="button"
                                        class="action-button"
                                        title="@(customer.IsActive ? "Deactivate customer" : "Activate customer")"
                                        @onclick="() => ToggleStatus(customer)">
                            @if (customer.IsActive)
                                    {
                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">
                                            <circle cx="12"
                                                    cy="12"
                                                    r="9" />
                                            <path d="M9 9l6 6" />
                                            <path d="M15 9l-6 6" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">
                                            <circle cx="12"
                                                    cy="12"
                                                    r="9" />
                                            <path d="m8 12 2.5 2.5L16 9" />
                                        </svg>
                                    }
                                </button>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>

@code {

    private List<CustomerDto> items = [];

    private CustomerDto edit = NewCustomerModel();

    private bool showForm;
    private bool loading;
    private bool saving;

    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        error = null;

        try
        {
            items =
                await Api.Get<List<CustomerDto>>(
                    "api/Customers")
                ?? [];
        }
        catch (Exception ex)
        {
            error =
                "Unable to load customers. " +
                ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void NewCustomer()
    {
        message = null;
        error = null;

        edit = NewCustomerModel();

        showForm = true;
    }

    private void EditCustomer(CustomerDto customer)
    {
        message = null;
        error = null;

        edit = new CustomerDto
        {
            Id = customer.Id,
            Name = customer.Name,
            Phone = customer.Phone,
            Email = customer.Email,
            Address = customer.Address,
            City = customer.City,
            ProvinceState = customer.ProvinceState,
            PostalCode = customer.PostalCode,
            Notes = customer.Notes,
            IsActive = customer.IsActive
        };

        showForm = true;
    }

    private void CancelEdit()
    {
        edit = NewCustomerModel();
        showForm = false;
        error = null;
    }

    private async Task Save()
    {
        message = null;
        error = null;

        if (string.IsNullOrWhiteSpace(edit.Name))
        {
            error = "Customer name is required.";
            return;
        }

        saving = true;

        try
        {
            var request = new
            {
                Name = edit.Name.Trim(),
                Phone = Clean(edit.Phone),
                Email = Clean(edit.Email),
                Address = Clean(edit.Address),
                City = Clean(edit.City),
                ProvinceState =
                    Clean(edit.ProvinceState),
                PostalCode =
                    Clean(edit.PostalCode),
                Notes = Clean(edit.Notes),
                edit.IsActive
            };

            bool success;

            if (edit.Id == 0)
            {
                success =
                    await Api.Post(
                        "api/Customers",
                        request);
            }
            else
            {
                success =
                    await Api.Put(
                        $"api/Customers/{edit.Id}",
                        request);
            }

            if (!success)
            {
                error =
                    "The customer could not be saved.";
                return;
            }

            message =
                edit.Id == 0
                    ? "Customer created successfully."
                    : "Customer updated successfully.";

            showForm = false;
            edit = NewCustomerModel();

            await Load();
        }
        catch (Exception ex)
        {
            error =
                "The customer could not be saved. " +
                ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleStatus(
        CustomerDto customer)
    {
        message = null;
        error = null;

        try
        {
            var newStatus = !customer.IsActive;

            var success =
                await Api.Patch(
                    $"api/Customers/{customer.Id}/status",
                    new
                    {
                        IsActive = newStatus
                    });

            if (!success)
            {
                error =
                    "The customer status could not be changed.";
                return;
            }

            message =
                newStatus
                    ? $"{customer.Name} has been activated."
                    : $"{customer.Name} has been deactivated.";

            await Load();
        }
        catch (Exception ex)
        {
            error =
                "The customer status could not be changed. " +
                ex.Message;
        }
    }

    private static CustomerDto NewCustomerModel()
    {
        return new CustomerDto
        {
            Name = "",
            IsActive = true
        };
    }

    private static string? Clean(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "—"
            : value;
    }
}