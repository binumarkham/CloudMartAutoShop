@page "/"
@inject ApiService Api
<PageTitle>Dashboard - CloudMart Auto Shop</PageTitle><h1>Dashboard</h1><p class="subtitle">Auto shop activity at a glance</p>@if(data==null){<p>Loading...</p>}else{<div class="cards"><div class="card"><small>Open Repair Orders</small><strong>@data.OpenRepairOrders</strong></div><div class="card"><small>Total Sales</small><strong>@data.TotalSales.ToString("C")</strong></div><div class="card"><small>Outstanding</small><strong>@data.Outstanding.ToString("C")</strong></div><div class="card"><small>Active Customers</small><strong>@data.Customers</strong></div><div class="card"><small>Active Vehicles</small><strong>@data.Vehicles</strong></div></div><div class="panel"><h3>Quick Start</h3><p class="subtitle">Use the navigation to manage customers, vehicles, repair orders, suppliers and reports.</p></div>}
@code{SummaryDto? data;protected override async Task OnInitializedAsync(){try{data=await Api.Get<SummaryDto>("api/Reports/summary");}catch{}}}
