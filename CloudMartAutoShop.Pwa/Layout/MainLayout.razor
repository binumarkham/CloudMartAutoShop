@inherits LayoutComponentBase
@implements IDisposable
@using System.Net.Http.Json
@using Microsoft.JSInterop
@inject ApiService Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http

<div class="shell">
    <aside>
        <div class="brand">
            <span class="mark">CM</span>
            <div>
                <strong>CloudMart Data</strong>
                <small>Small Business Portal</small>
                <small>v1.0.28</small>
            </div>
        </div>

        <NavMenu />
    </aside>

    <main>
        <header class="app-header">
            <div class="mobile-cloudmart-brand">                
                <strong>CloudMart Data</strong>
            </div>
            <div class="mobile-version">
                Auto Shop &bull; v1.0.28
            </div>
            <div class="header-branding">
                <strong>Auto Shop</strong>
                <span>Professional Service Management</span>
            </div>

            <span class="spacer"></span>

            @if (isLoggedIn)
            {
                <div class="header-account">
                    <div class="header-user">
                        <strong>@businessName</strong>
                        <span>@userEmail</span>
                    </div>

                    <button class="header-logout" @onclick="OpenMyAccount">
                        My Account
                    </button>
                    @if (isAdministrator)
                    {
                        <button class="header-logout" @onclick="OpenUsers">
                            Users
                        </button>
                    }
                    <button class="header-logout" @onclick="Logout">
                        Logout
                    </button>
                </div>
            }
        </header>

        @if (_updateAvailable)
        {
            <div class="update-banner">
                <div class="update-message">
                    <strong>New version available</strong>
                    <span>
                        CloudMart Auto Shop @_latestVersion is ready.
                    </span>
                </div>

                <button class="update-button"
                        @onclick="UpdateNow">
                    Update Now
                </button>
            </div>
        }

        <section class="content">
            @Body
        </section>
    </main>
</div>

@code {
    private const string CurrentVersion = "1.0.28";

    private bool isLoggedIn;
    private string userName = "";
    private string userEmail = "";
    private string businessName = "";
    private bool isAdministrator;
    private bool _updateAvailable;
    private string _latestVersion = "";
    private DotNetObjectReference<MainLayout>? _dotNetReference;
    private PeriodicTimer? _updateTimer;
    private CancellationTokenSource? _updateCancellation;

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string?>(
            "localStorage.getItem",
            "authToken");

        isLoggedIn = !string.IsNullOrWhiteSpace(token);

        if (isLoggedIn)
        {
            userName = await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                "userName") ?? "User";
            userEmail = await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                "userEmail") ?? "";
            businessName = await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                "businessName") ?? "";

            var role = await JS.InvokeAsync<string?>(
"localStorage.getItem",
"userRole") ?? "";

            isAdministrator =
                string.Equals(
                    role,
                    "Administrator",
                    StringComparison.OrdinalIgnoreCase)
                ||
                string.Equals(
                    role,
                    "Admin",
                    StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _dotNetReference =
            DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync(
            "cloudMartAutoShopPwa.setDotNetReference",
            _dotNetReference);

        await CheckForUpdateAsync();

        _updateCancellation = new CancellationTokenSource();
        _updateTimer = new PeriodicTimer(TimeSpan.FromMinutes(5));

        _ = MonitorForUpdatesAsync(
            _updateCancellation.Token);
    }

    private async Task MonitorForUpdatesAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            while (_updateTimer is not null &&
                   await _updateTimer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(CheckForUpdateAsync);
            }
        }
        catch (OperationCanceledException)
        {
            // Normal when the layout is disposed.
        }
    }

    private async Task CheckForUpdateAsync()
    {
        try
        {
            var url =
                $"{Nav.BaseUri}version.json?v={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";

            var versionInfo =
                await Http.GetFromJsonAsync<VersionInfo>(url);

            if (versionInfo is null ||
                string.IsNullOrWhiteSpace(versionInfo.Version))
            {
                return;
            }

            _latestVersion = versionInfo.Version.Trim();

            _updateAvailable =
                !string.Equals(
                    _latestVersion,
                    CurrentVersion,
                    StringComparison.OrdinalIgnoreCase);

            if (_updateAvailable)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // Update checking must never prevent Auto Shop from working.
        }
    }

    [JSInvokable]
    public async Task CheckForUpdateFromBrowser()
    {
        await CheckForUpdateAsync();
    }

    private async Task UpdateNow()
    {
        _updateAvailable = false;
        await InvokeAsync(StateHasChanged);

        await JS.InvokeVoidAsync(
            "cloudMartAutoShopForceUpdate");
    }
    private void OpenMyAccount()
    {
        Nav.NavigateTo("my-account");
    }
    private void OpenUsers()
    {
        Nav.NavigateTo("users");
    }
    private async Task Logout()
    {
        await Api.Logout();

        Nav.NavigateTo("login", forceLoad: true);
    }

    public void Dispose()
    {
        _updateCancellation?.Cancel();
        _updateCancellation?.Dispose();
        _updateTimer?.Dispose();
        _dotNetReference?.Dispose();
    }

    private sealed class VersionInfo
    {
        public string Version { get; set; } = "";
    }
}



































